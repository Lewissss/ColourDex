{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "pencils": {
      "type": "array",
      "minItems": 240,
      "maxItems": 240,
      "items": {
        "type": "object",
        "properties": {
          "number": {
            "type": "string",
            "pattern": "^(00[1-9]|0[1-9][0-9]|1[0-9]{2}|2[0-3][0-9]|240)$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "hex": {
            "type": "string",
            "pattern": "^#[a-fA-F0-9]{6}$"
          },
          "family": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "number",
          "name",
          "hex",
          "family"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "description",
    "pencils"
  ],
  "additionalProperties": false
}
